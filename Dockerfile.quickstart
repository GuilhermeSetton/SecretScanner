# syntax=docker/dockerfile:1

FROM golang:1.26-alpine AS scanner-builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/secretscanner \
    ./cmd/secretscanner

FROM python:3.12-alpine

WORKDIR /app

COPY python /app/python
RUN python -m pip install --no-cache-dir -e /app/python

COPY --from=scanner-builder /out/secretscanner /usr/local/bin/secretscanner
COPY scripts/quickstart.sh /usr/local/bin/quickstart
RUN chmod +x /usr/local/bin/quickstart

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/quickstart"]
