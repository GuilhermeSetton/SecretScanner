# syntax=docker/dockerfile:1
# Build Stage
FROM golang:1.24-alpine AS builder

WORKDIR /src

RUN apk add --no-cache ca-certificates tzdata

COPY go.mod go.sum* ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w -extldflags '-static'" \
    -o /out/admission-webhook \
    ./cmd/admission-webhook

# Final Hardened Stage
FROM alpine:3.20

RUN apk --no-cache add ca-certificates \
    && addgroup -g 10001 -S webhook \
    && adduser -u 10001 -S webhook -G webhook

COPY --from=builder --chown=10001:10001 /out/admission-webhook /usr/local/bin/admission-webhook

USER 10001:10001
EXPOSE 8443

ENTRYPOINT ["/usr/local/bin/admission-webhook"]
CMD ["-port=8443", "-mode=enforce", "-min-severity=high"]
